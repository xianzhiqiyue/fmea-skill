{
  "schema_id": "openclaw_fmea_review_cards",
  "version": "0.2.0",
  "description": "OpenClaw review card contract derived from the FMEA draft JSON artifact.",
  "source_artifact": "draft_fmea_from_cases.py JSON output",
  "primary_sections": [
    "confirmation_queue",
    "top_risks"
  ],
  "top_level_fields": [
    {
      "field": "cards_version",
      "type": "string",
      "required": true
    },
    {
      "field": "module",
      "type": "string",
      "required": true
    },
    {
      "field": "fmea_type",
      "type": "string",
      "required": true
    },
    {
      "field": "summary",
      "type": "object",
      "required": true
    },
    {
      "field": "artifact_links",
      "type": "object",
      "required": true
    },
    {
      "field": "sections",
      "type": "array",
      "required": true
    }
  ],
  "card_common_fields": [
    {
      "field": "card_id",
      "type": "string",
      "required": true
    },
    {
      "field": "card_type",
      "type": "string",
      "required": true
    },
    {
      "field": "title",
      "type": "string",
      "required": true
    },
    {
      "field": "subtitle",
      "type": "string",
      "required": false
    },
    {
      "field": "target",
      "type": "object",
      "required": true,
      "description": "Stable row locator passed to review mutation actions."
    },
    {
      "field": "priority",
      "type": "string",
      "required": true,
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    {
      "field": "tags",
      "type": "array",
      "required": true
    },
    {
      "field": "payload",
      "type": "object",
      "required": true
    },
    {
      "field": "actions",
      "type": "array",
      "required": true
    }
  ],
  "sections": [
    {
      "section_id": "confirmation_queue",
      "title": "确认队列",
      "card_type": "confirmation_review",
      "description": "用于人工确认 scope 边界、借用类比和评分依据的卡片。",
      "payload_fields": [
        "scope",
        "row_key",
        "why_confirmation_is_needed",
        "suggested_reviewer_focus",
        "review_comment",
        "reference_type",
        "source_cases",
        "reason_tags"
      ],
      "suggested_actions": [
        "confirm_row",
        "confirm_scope_owner",
        "confirm_reference_fit",
        "confirm_scores",
        "set_owner_target"
      ]
    },
    {
      "section_id": "top_risks",
      "title": "Top风险",
      "card_type": "top_risk_digest",
      "description": "用于展示高 RPN 风险和首要动作建议的卡片。",
      "payload_fields": [
        "scope",
        "row_key",
        "failure_mode",
        "current_rpn",
        "rpn_band",
        "why_it_matters",
        "first_action_candidate",
        "reference_type"
      ],
      "suggested_actions": [
        "open_source_trace",
        "set_owner_target",
        "confirm_reference_fit"
      ]
    }
  ]
}
